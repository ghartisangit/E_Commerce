@model E_Commerce.DTOs.ProductDto

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container">
    <div class="form-container">
        <div class="form-header">
            <h1>✏️ Edit Product</h1>
            <p style="color: var(--gray); margin-top: 0.5rem;">Update product information</p>
        </div>

        <form method="post" asp-action="EditProduct" asp-route-id="@Model.Id">
            <div class="form-group">
                <label asp-for="Name">Product Name *</label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" style="color: var(--danger); font-size: 0.9rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Description *</label>
                <textarea asp-for="Description" class="form-control" required></textarea>
                <span asp-validation-for="Description" style="color: var(--danger); font-size: 0.9rem;"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Price">Price ($) *</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                    <span asp-validation-for="Price" style="color: var(--danger); font-size: 0.9rem;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="StockQuantity">Stock Quantity *</label>
                    <input asp-for="StockQuantity" type="number" class="form-control" required />
                    <span asp-validation-for="StockQuantity" style="color: var(--danger); font-size: 0.9rem;"></span>
                </div>
            </div>

          

            <div class="form-group">
                <label asp-for="ImageUrl">Image URL</label>
                <input asp-for="ImageUrl" type="url" class="form-control" onchange="previewImage(this.value)" />
                <span asp-validation-for="ImageUrl" style="color: var(--danger); font-size: 0.9rem;"></span>

                <div class="image-preview" id="imagePreview">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="Preview" style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px;" />
                    }
                    else
                    {
                        <span>📷</span>
                    }
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" style="flex: 1;">Update Product</button>
                <a href="/Admin/Dashboard" class="btn btn-outline" style="flex: 1; text-align: center;">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
    function previewImage(url) {
        const preview = document.getElementById('imagePreview');
        if (url) {
            preview.innerHTML = `<img src="${url}" alt="Preview" style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px;" onerror="this.parentElement.innerHTML='<span>❌ Invalid URL</span>'" />`;
        } else {
            preview.innerHTML = '<span>📷</span>';
        }
    }
</script>