



@model Order
@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="alert alert-success text-center">
                <h3><i class="fas fa-check-circle"></i> Order Confirmed!</h3>
                <p>Thank you for your purchase. Your order has been successfully placed.</p>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5>Order Details</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Order ID:</strong> #@Model.Id
                        </div>
                        <div class="col-md-6">
                            <strong>Date:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Status:</strong>
                            <span class="badge bg-success">@Model.Status</span>
                        </div>
                        <div class="col-md-6">
                            <strong>Total:</strong> $@Model.TotalAmount.ToString("N2")
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.PaymentTransactionId))
                    {
                        <div class="row mb-3">
                            <div class="col-12">
                                <strong>Transaction ID:</strong><br />
                                <small class="text-muted">@Model.PaymentTransactionId</small>
                            </div>
                        </div>
                    }

                    <hr />

                    <h6>Shipping Information</h6>
                    <p>
                        <strong>@Model.ShippingName</strong><br />
                        @Model.ShippingAddress<br />
                        @Model.ShippingCity<br />
                        @Model.ShippingPhone<br />
                        @Model.ShippingEmail
                    </p>

                    <hr />

                    <h6>Order Items</h6>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Price</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>@item.Product.Name</td>
                                    <td>@item.Quantity</td>
                                    <td>$@item.Price.ToString("N2")</td>
                                    <td>$@((item.Price * item.Quantity).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                <td><strong>$@Model.TotalAmount.ToString("N2")</strong></td>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="text-center mt-4">
                        <a asp-action="MyOrders" class="btn btn-primary">View All Orders</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Continue Shopping</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>